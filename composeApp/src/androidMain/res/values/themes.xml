<?xml version="1.0" encoding="utf-8"?>

<resources>
<style name="Theme.App.Starting" parent="Theme.SplashScreen">
    <item name="windowSplashScreenBackground">@color/bc_ground</item>
    <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    <!-- Provisional: el cerebro es blanco y el fondo del splash crema; el circulo lo hace visible hasta el paso del splash. -->
    <item name="windowSplashScreenIconBackgroundColor">@color/ic_launcher_background</item>
    <item name="postSplashScreenTheme">@style/Theme.App.Base</item>
</style>
<!-- Tema base de la app y de la ventana tras el splash: mismo color que el fondo del tema (claro; oscuro en values-night). -->
<style name="Theme.App.Base" parent="android:Theme.Material.Light.NoActionBar">
    <item name="android:windowBackground">@color/bc_ground</item>
</style>
</resources>