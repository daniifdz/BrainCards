<?xml version="1.0" encoding="utf-8"?>

<resources>
<style name="Theme.App.Starting" parent="Theme.SplashScreen">
    <item name="windowSplashScreenBackground">@color/splash_background</item>
    <item name="windowSplashScreenAnimatedIcon">@drawable/splash_system_icon</item>
    <!-- Iconos de la barra de estado claros sobre el morado en el splash del sistema (en claro y oscuro). Solo afecta a la ventana
         del splash: EntryPending en Compose sigue las barras que fija MainActivity.applySystemBars. -->
    <item name="android:windowLightStatusBar">false</item>
    <item name="postSplashScreenTheme">@style/Theme.App.Base</item>
</style>
<!-- Tema base de la app y de la ventana tras el splash: mismo color que el fondo del tema (claro; oscuro en values-night). -->
<style name="Theme.App.Base" parent="android:Theme.Material.Light.NoActionBar">
    <item name="android:windowBackground">@color/bc_ground</item>
</style>
</resources>